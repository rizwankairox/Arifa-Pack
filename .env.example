# Copy this file to .env.local and paste your key to give the voice assistant a real AI brain.
# Without a key the assistant still works, using its built-in scripted salesperson.
# The key stays on the server (src/app/api/assistant/route.ts) and is never sent to the browser.
# On Vercel: Project → Settings → Environment Variables → add ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# ── The Arifa backend (website API: WEBSITE_API.pdf) ──
# Set this and the assistant talks to the backend instead of its built-in brain: chat turns,
# live voice (LiveKit), and linking a conversation to the visitor once they type their details.
# Local mock: npx @stoplight/prism-cli mock docs/frontend/openapi-website.json --port 4011
#   (or: node scripts/mock-arifa-api.mjs, which also covers voice and errors)
# The backend must allow this site's origin (CORS): the browser calls it directly.
NEXT_PUBLIC_ARIFA_API_URL=
# Cloudflare Turnstile site key (the backend checks the token; leave empty only against a local backend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# WhatsApp number for click-to-chat when the assistant is unavailable (digits, country code first).
# Empty: the packaging division's line.
NEXT_PUBLIC_WHATSAPP_NUMBER=
