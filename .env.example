# ═══════════════════════════════════════════════════════════════════════════════════════════════
#  BACKEND CONNECTION — Arifa Pack website  ↔  Kairox backend
#
#  This is the one place the site is connected to the backend. No code needs changing.
#    1. Copy this file to  .env.local  (same folder) and fill in the values below.
#    2. On Vercel: Project → Settings → Environment Variables → add the same names and values.
#    3. Restart (npm run dev) or redeploy. Empty values = that part stays off and the site keeps
#       working on its own (built-in assistant, the email app for enquiries, content from src/data).
#
#  The assistant (Arifa): with the address set and the backend reachable, the backend answers every
#  turn (live voice through LiveKit, the panel's tag reads "Live AI"). If it can't be reached (not
#  running, wrong address, CORS, server error), the site's own built-in assistant and browser voice
#  answer instead, retrying the backend after a minute (tag: "Preview"). The browser console says
#  which one answered: "[Arifa] answered by the backend" / "… answered by the built-in assistant".
#
#  The code that uses these values:
#    src/lib/arifaApi.ts               Website API  (/v1/public/*: sessions, messages, voice, identify,
#                                                    contact, events, enquiries)      WEBSITE_API.md
#    src/lib/arifaContent.ts           CMS, read side (/v1/content/*)                  CMS_API.md
#    src/app/api/revalidate/route.ts   called by the backend on every publish          CMS_API.md §4
#    src/app/api/draft/route.ts        editor preview (draft mode)                     CMS_API.md §5
#
#  Backend side: list this site's address in KX_APP_CORS_PUBLIC_ORIGINS (the browser calls
#  /v1/public/* and /v1/content/* directly, without credentials).
# ═══════════════════════════════════════════════════════════════════════════════════════════════


# ── 1. Backend address (Website API and CMS) ─────────────────────────────────────────────────────
#   production  https://api.arifapack.com
#   test stack  http://localhost:38000
#   mock        http://localhost:4011   (node scripts/mock-arifa-api.mjs: testing only, not the backend)
NEXT_PUBLIC_ARIFA_API_URL=

# Content API address, only if it is NOT on the address above. Server only. Usually empty.
ARIFA_CONTENT_URL=


# ── 2. Values the backend team provides ──────────────────────────────────────────────────────────
# Cloudflare Turnstile SITE key (the human check before a conversation or an enquiry).
# Empty only against a local backend without a Turnstile secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret for /api/revalidate. Must equal the backend's KX_APP_WEBSITE_REVALIDATE_SECRET. Server only.
KX_REVALIDATE_SECRET=

# Public URL of the CMS media bucket (Cloudflare R2), where photos and videos are served from.
NEXT_PUBLIC_MEDIA_URL=


# ── 3. Optional ──────────────────────────────────────────────────────────────────────────────────
# WhatsApp number for click-to-chat when the assistant is unavailable (digits, country code first).
# Empty: the packaging division's line, +971 6 748 5384.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Only used while NEXT_PUBLIC_ARIFA_API_URL is empty: the site's own built-in assistant then calls
# Claude directly (src/app/api/assistant/route.ts). Not needed once the backend is connected.
ANTHROPIC_API_KEY=
