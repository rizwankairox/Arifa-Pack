# Copy this file to .env.local and paste your key to give the voice assistant a real AI brain.
# Without a key the assistant still works, using its built-in scripted salesperson.
# The key stays on the server (src/app/api/assistant/route.ts) and is never sent to the browser.
# On Vercel: Project → Settings → Environment Variables → add ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
